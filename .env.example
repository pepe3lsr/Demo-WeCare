# Copiá este archivo a `.env` y completá las claves. El .env NO se sube al repo.

# Asistente conversacional (Claude). Sin esta clave el tótem responde con frases básicas desde la base.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Voz (Fish Audio). Sin esta clave el tótem funciona con pantalla y teclado.
FISH_API_KEY=
# reference_id de la voz elegida en https://fish.audio (vacío = voz por defecto del modelo)
FISH_VOICE_ID=
FISH_TTS_MODEL=s2-pro
FISH_ASR_LANGUAGE=es

# Institución
INSTITUTION_NAME=Residencia Demo
TIMEZONE=America/Argentina/Buenos_Aires

# Reconocimiento facial local
FACE_PACK=buffalo_sc          # buffalo_sc (rápido, 16 MB) | buffalo_l (más preciso, 190 MB)
FACE_THRESHOLD=0.40
FACE_CONFIRM_FRAMES=2
PRESENCE_TIMEOUT_S=25

# Demo
DEMO_RESET_ON_START=false     # true = vuelve a sembrar los datos ficticios en cada arranque
